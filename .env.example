# Required — Neon/Vercel Postgres connection string (full URL)
DATABASE_URL='postgres://user:password@host/dbname'

# Required — base64 string, e.g. openssl rand -base64 32
SESSION_SECRET=''

# Required — your real auth.jwt.secret (used for customer JWT sessions)
AUTH_SECRET=''

# Required — base URL of the app (no trailing slash)
AUTH_URL='http://localhost:3000'

# OAuth — Google
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''

# OAuth — Apple (Sign in with Apple)
# Apple Client ID = Services ID (e.g. com.baddiesplug.lashes.service)
APPLE_CLIENT_ID=''
# For JWT sessions, Apple uses a client secret generated from the .p8 key
APPLE_CLIENT_SECRET=''
# Apple Team ID (found in Apple Developer portal)
APPLE_TEAM_ID=''
# Apple Key ID (the 10-char ID of your Sign in with Apple key)
APPLE_KEY_ID=''
# Path to the .p8 private key file (store securely, do NOT commit)
# Alternatively, paste the key content directly with APPLE_PRIVATE_KEY
APPLE_PRIVATE_KEY_PATH=''
APPLE_PRIVATE_KEY=''

# Optional — Resend transactional email
RESEND_API_KEY=''
RESEND_FROM_EMAIL='noreply@baddiesplug.com'

# Optional — Cloudflare R2 (photo uploads)
R2_ACCOUNT_ID=''
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
R2_BUCKET_NAME='baddiesplug-lashes'
R2_PUBLIC_URL=''

# Optional — WhatsApp payment deep link number (digits only)
WHATSAPP_NUMBER=''

# Required if using Vercel Cron for scheduled jobs
CRON_SECRET=''
